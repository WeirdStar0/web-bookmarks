# 环境变量配置示例文件
# 复制此文件为 .dev.vars 并填入实际值
# .dev.vars 文件不应提交到 Git 仓库

# 密钥用于签名 Cookie
# 本地开发未设置时会自动生成临时密钥;生产(非 localhost)必须显式设置,否则服务失败关闭
# 请使用强随机字符串,至少 32 个字符
# 可以使用以下命令生成: openssl rand -base64 32
SECRET_KEY=your-secret-key-replace-me-in-production

# 生产环境首次初始化管理员密码
# 请使用至少 12 个字符的强随机密码。生产环境未设置时不会自动创建管理员账户。
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-initial-password

# 可选但推荐:密码哈希 pepper,仅存于 Worker Secrets / 本地 .dev.vars,绝不落库
# 值格式 "<id>:<material>":id 每次轮换唯一(1-16 位字母数字),material 建议 openssl rand -base64 32
# PASSWORD_PEPPER=k1:replace-with-random-material
# PASSWORD_PEPPER_PREVIOUS=k0:previous-value-only-kept-during-rotation

# 可选:会话过期时间(秒),默认 7 天 (604800)
# SESSION_MAX_AGE=604800

# 速率限制配置。生产环境还必须在 wrangler.toml 绑定 RATE_LIMIT_KV，
# 否则登录端点会返回 503 且部署前检查会失败。
# 每个时间窗口内的最大请求数
# RATE_LIMIT_MAX=100
# 时间窗口(秒)
# RATE_LIMIT_WINDOW=60
